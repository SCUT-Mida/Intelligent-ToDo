{
  "name": "intelligent-todo",
  "productName": "Intelligent-ToDo",
  "version": "1.25.5",
  "description": "本地AI工具集 - Smart Todo, Repo Navigator, Agent Hub & API Tester desktop suite",
  "main": "./out/main/index.js",
  "author": "intelligent-todo",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "build:win": "electron-vite build && electron-builder --win",
    "gen:icon": "node scripts/generate-icon.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src tests"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.14",
    "@xterm/addon-unicode-graphemes": "^0.4.0",
    "electron-updater": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "oxlint": "^1.78.0",
    "sharp": "^0.35.3",
    "to-ico": "^1.1.5",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
